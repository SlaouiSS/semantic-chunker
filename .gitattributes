# Normalize line endings for reproducible builds and consistent diffs.
* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.editorconfig text eol=lf
mvnw     text eol=lf

# Windows scripts keep CRLF.
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Binary artifacts.
*.jar    binary
*.png    binary
*.pdf    binary

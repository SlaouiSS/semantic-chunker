<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.slaouiss</groupId>
        <artifactId>semantic-chunker</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>semantic-chunker-spring-ai</artifactId>
    <packaging>jar</packaging>

    <name>semantic-chunker-spring-ai</name>
    <description>
        A ChunkingModel adapter that lets a language model be supplied by way of Spring AI. Depends on
        the core; the core does not depend on it.
    </description>

    <properties>
        <!--
            The Spring AI version is declared here rather than in the parent so that the churn of this
            upstream stays inside the module that adapts it and never reaches the core
            (CONTRIBUTING_ARCHITECTURE.md, section 13.4).
        -->
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.slaouiss</groupId>
            <artifactId>semantic-chunker-core</artifactId>
        </dependency>

        <!--
            The provider-neutral Spring AI abstractions, and nothing more
            (CONTRIBUTING_ARCHITECTURE.md, section 4.1.2). spring-ai-model carries ChatModel and the
            neutral chat types; spring-ai-commons carries TokenCountEstimator. No provider artifact,
            no spring-ai-client-chat (ChatClient is not used), and no Spring Boot: a provider
            artifact on this classpath would make a provider-specific reference compile.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-commons</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
